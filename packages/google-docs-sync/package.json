{
  "name": "google-docs-sync",
  "version": "0.1.1",
  "description": "Sync a Google Drive folder of Google Docs to local Markdown or MDX files",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedricdelpoux/google-docs-sync.git",
    "directory": "packages/google-docs-sync"
  },
  "homepage": "https://github.com/cedricdelpoux/google-docs-sync/tree/master/packages/google-docs-sync#readme",
  "bugs": {
    "url": "https://github.com/cedricdelpoux/google-docs-sync/issues"
  },
  "author": "Cédric Delpoux <cedric.delpoux@gmail.com>",
  "license": "MIT",
  "keywords": [
    "google",
    "google-docs",
    "google-drive",
    "docs",
    "drive",
    "markdown",
    "mdx",
    "sync"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "bin",
    "lib",
    "types"
  ],
  "bin": {
    "google-docs-sync": "bin/sync.js",
    "google-docs-sync-token": "bin/generate-token.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@googleapis/docs": "^14.1.1",
    "@googleapis/drive": "^27.1.0",
    "google-auth-library": "^11.3.4",
    "google-docs-to-markdown": "^2.0.1",
    "google-oauth2-env-vars": "^2.0.1",
    "lodash": "^4.18.1",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "build": "tsc",
    "fixture": "node scripts/write-fixture.js",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run --coverage",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test"
  }
}
