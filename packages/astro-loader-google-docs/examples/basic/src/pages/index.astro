---
import {getCollection} from "astro:content"

const docs = (await getCollection("docs")).sort((a, b) =>
  a.data.slug.localeCompare(b.data.slug)
)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Google Docs</title>
  </head>
  <body>
    <h1>Google Docs</h1>
    <ul>
      {
        docs.map((doc) => (
          <li>
            <a href={doc.id === "index" ? "/home" : `/${doc.id}`}>{doc.data.name}</a>
          </li>
        ))
      }
    </ul>
  </body>
</html>
